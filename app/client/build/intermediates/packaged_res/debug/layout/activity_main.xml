<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Vito"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Where would you like to go?"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnRide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VitoRide"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VitoSend"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnMart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VitoMart"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/demoMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Demo Mode: ON"
        android:textColor="#2196F3"
        android:layout_marginTop="32dp"/>

</LinearLayout>
